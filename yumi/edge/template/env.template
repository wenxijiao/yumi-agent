# Yumi Edge Configuration
# Run `yumi --edge` to choose Yumi Nexus, a local/custom server, or connect later.

# Direct WebSocket URL, LAN code (yumi-lan_...), or account connection code.
YUMI_CONNECTION_CODE=

# Needed only for a remote account code; direct URLs/LAN codes include a host.
YUMI_EDGE_SERVER=

# Browser sign-in or an explicitly supplied device credential fills these.
YUMI_RELAY_URL=
YUMI_ACCESS_TOKEN=

# Device name (must match the name bound to its device credential).
EDGE_NAME=My_Edge_Node
